rules_version = '2';

// Riptide Officials: Firestore security rules.
// Paste this whole file into Firebase Console > Firestore Database > Rules > Publish.
//
// Who can do what:
//  - Anyone with a meet's link can read that meet and its sign-up NAMES, and can sign up.
//    (Meet IDs are long random codes, so they cannot be guessed or browsed.)
//  - Email and phone are stored in a separate "contacts" collection that ONLY the admin can read.
//  - Signed-in, approved members can list all meets (for the calendar).
//  - Admins (the owner, plus anyone the owner marks as admin, e.g. another Meet Ref) can create/edit/delete
//    meets, read contact details, and approve members. Only the owner can grant or remove admin.
//
// If you ever change the owner email, change it in firebase-config.js AND here.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }

    // The owner (main coordinator): identified by verified email. Can also grant admin to others.
    function isOwner() {
      return signedIn()
        && request.auth.token.email == 'whpeterson@gmail.com'
        && request.auth.token.email_verified == true;
    }

    function hasProfile() {
      return signedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    function profile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Admins = the owner plus any approved member the owner has marked as admin (e.g. another Meet Ref).
    function isAdmin() {
      return isOwner() || (hasProfile() && profile().approved == true && profile().get('admin', false) == true);
    }

    function isMember() {
      return isOwner() || (hasProfile() && profile().approved == true);
    }

    function adminUnchanged() {
      return request.resource.data.get('admin', false) == resource.data.get('admin', false);
    }

    // Member profiles. People create their own (always unapproved, never admin).
    // Admins can approve members; only the owner can grant or remove admin.
    match /users/{uid} {
      allow read: if isAdmin() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'approved', 'createdAt'])
        && request.resource.data.approved == false
        && request.resource.data.name is string && request.resource.data.name.size() <= 80
        && request.resource.data.email is string && request.resource.data.email.size() <= 120
        && request.resource.data.phone is string && request.resource.data.phone.size() <= 30;
      allow update: if isOwner()
        || (isAdmin() && adminUnchanged())
        || (signedIn() && request.auth.uid == uid
            && request.resource.data.approved == resource.data.approved
            && adminUnchanged()
            && request.resource.data.keys().hasOnly(['name', 'email', 'phone', 'approved', 'admin', 'createdAt']));
      allow delete: if isAdmin();

      // The private edit codes for sign-ups this member made (one per meet).
      match /mysignups/{meetId} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create, update: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['key']);
      }

      // Each member's checklist progress on the how-to pages. Only that member can read or write it.
      match /progress/{pageKey} {
        allow read: if signedIn() && request.auth.uid == uid;
        allow write: if signedIn() && request.auth.uid == uid && isMember()
          && request.resource.data.keys().hasOnly(['done', 'updatedAt'])
          && request.resource.data.done is list && request.resource.data.done.size() <= 100;
      }
    }

    // Team-only info (e.g. the team's USA Swimming registration link). Approved members read; only admin writes.
    match /private/{doc} {
      allow read: if isMember();
      allow write: if isAdmin();
    }

    // "Interested in becoming an official" form: anyone can submit; only admins can read or delete.
    match /interest/{id} {
      allow create: if request.resource.data.keys().hasOnly(['name','email','phone','swimmer','message','createdAt'])
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() < 200
        && request.resource.data.email is string && request.resource.data.email.size() > 3 && request.resource.data.email.size() < 200
        && (!('phone' in request.resource.data) || (request.resource.data.phone is string && request.resource.data.phone.size() < 60))
        && (!('swimmer' in request.resource.data) || (request.resource.data.swimmer is string && request.resource.data.swimmer.size() < 200))
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() < 3000));
      allow read, update, delete: if isAdmin();
    }

    match /meets/{meetId} {
      allow get: if true;               // anyone who knows the (unguessable) link
      allow list: if isMember();        // calendar and meet list
      allow create, update, delete: if isAdmin();

      // One document per sign-up, keyed by a random secret code. Nobody can list them (only admins can),
      // so only the person who signed up (who holds their private edit link) or an admin can open one.
      match /contacts/{key} {
        function validSignup(d) {
          return d.keys().hasOnly(['name', 'email', 'phone', 'comments', 'team', 'role', 'certified', 'shadow', 'perSession', 'session', 'uid', 'createdAt'])
            && d.name is string && d.name.size() > 0 && d.name.size() <= 80
            && d.email is string && d.email.size() <= 120
            && d.phone is string && d.phone.size() <= 30
            && d.team is string && d.team.size() <= 80
            && d.role is string && d.role.size() <= 200
            && d.certified is list && d.certified.size() <= 12
            && d.shadow is list && d.shadow.size() <= 12
            && d.session is string && d.session.size() <= 200
            && (!('perSession' in d) || (d.perSession is list && d.perSession.size() <= 20))
            && (!('comments' in d) || (d.comments is string && d.comments.size() <= 500));
        }
        allow get: if true;
        allow list: if isAdmin();
        allow create: if validSignup(request.resource.data)
          && (request.resource.data.uid == null || (signedIn() && request.resource.data.uid == request.auth.uid));
        allow update: if isAdmin() || (validSignup(request.resource.data)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.createdAt == resource.data.createdAt);
        allow delete: if true;
      }
    }
  }
}
